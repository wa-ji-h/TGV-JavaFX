<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15"
      alignment="CENTER"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tgv.controllers.AdminReclamationsController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Gestion des Réclamations"/>

    <HBox spacing="10" alignment="CENTER">
        <ComboBox fx:id="statutFilter" promptText="Filtrer par statut"/>
        <ComboBox fx:id="typeFilter" promptText="Filtrer par type service"/>
        <Button text="Filtrer" onAction="#filtrer"/>
        <Button text="Reset" onAction="#resetFilter"/>
    </HBox>

    <TextField fx:id="searchField" promptText="Rechercher par sujet, message, statut, type service"/>

    <TableView fx:id="tableReclamation" prefWidth="1000" prefHeight="420">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colSubject" text="Sujet" prefWidth="160"/>
            <TableColumn fx:id="colMessage" text="Message" prefWidth="220"/>
            <TableColumn fx:id="colStatus" text="Statut" prefWidth="120"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="180"/>
            <TableColumn fx:id="colTypeService" text="Type service" prefWidth="140"/>
            <TableColumn fx:id="colUserId" text="User ID" prefWidth="100"/>
            <TableColumn fx:id="colDejaRepondu" text="Client répondu" prefWidth="120"/>
            <TableColumn fx:id="colPhone" text="Téléphone client" prefWidth="140"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Changer statut" onAction="#changerStatut"/>
        <Button text="Répondre" onAction="#repondreReclamation"/>
        <Button text="Supprimer" onAction="#supprimerReclamation"/>
        <Button text="Retour" onAction="#retourAdmin"/>
    </HBox>

</VBox>

