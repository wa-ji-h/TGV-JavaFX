<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tgv.controllers.FrontController"
            stylesheets="@../css/style.css"
            styleClass="front-background">

    <!-- Navbar / Header du Front-office -->
    <top>
        <HBox styleClass="front-navbar" alignment="CENTER" spacing="30">
            <Region minWidth="20"/>

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-cursor: hand;" onMouseClicked="#openDashboard">
                <ImageView fitWidth="100" preserveRatio="true">
                    <image>
                        <Image url="@../images/logo.png"/>
                    </image>
                </ImageView>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Nav Links -->
            <HBox alignment="CENTER" spacing="25">
                <Button text="🏠 Accueil" styleClass="front-nav-link"/>
                <Button text="🏪 Shop ⌄" styleClass="front-nav-link"/>
                <Button text="🛠 Services ⌄" styleClass="front-nav-link"/>
                <Button text="🎧 Support ⌄" styleClass="front-nav-link"/>
                <Button text="👥 Partenaires" styleClass="front-nav-link"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Right Actions -->
            <HBox alignment="CENTER" spacing="18">
                <Button styleClass="front-cart-btn">
                    <graphic><Region styleClass="top-icon, icon-cart"/></graphic>
                </Button>
                <!-- Retour au dashboard via Connexion -->
                <Button text="🚪 Connexion" styleClass="front-nav-link" onMouseClicked="#openDashboard"/>
                <Button text="👤 S'inscrire" styleClass="front-primary-btn"/>
            </HBox>
            
            <Region minWidth="20"/>
        </HBox>
    </top>

    <!-- Background Hero Section Placeholder -->
    <center>
        <VBox alignment="CENTER" spacing="20">
            <Label text="Bienvenue sur TGV Delivery Front-Office" styleClass="front-hero-title"/>
            <Label text="L'interface client complète sera ici..." styleClass="front-hero-subtitle"/>
            <Button text="Aller vers le Tableau de bord Administration" styleClass="front-primary-btn" onMouseClicked="#openDashboard"/>
        </VBox>
    </center>

</BorderPane>
