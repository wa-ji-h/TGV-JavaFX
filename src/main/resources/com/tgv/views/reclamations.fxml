<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tgv.controllers.ReclamationsController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- En-tête : Recherche et Filtres -->
    <top>
        <VBox spacing="10" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="15"/>
            </BorderPane.margin>
            <Label text="Gestion des Réclamations" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="🔍 Rechercher (sujet, message...)" prefWidth="300" onKeyReleased="#handleSearch"/>
                <ComboBox fx:id="statutFilter" promptText="Statut"/>
                <ComboBox fx:id="typeFilter" promptText="Type Service"/>
                <Button text="Filtrer" onAction="#handleFilter" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                <Button text="Reset" onAction="#handleReset" style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </top>

    <!-- Centre : Table View -->
    <center>
        <TableView fx:id="tableReclamations" prefWidth="700" onMouseClicked="#handleTableClick">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="40"/>
                <TableColumn fx:id="colSubject" text="Sujet" prefWidth="120"/>
                <TableColumn fx:id="colMessage" text="Message" prefWidth="180"/>
                <TableColumn fx:id="colStatus" text="Statut" prefWidth="90"/>
                <TableColumn fx:id="colDate" text="Date Création" prefWidth="130"/>
                <TableColumn fx:id="colTypeService" text="Type" prefWidth="90"/>
                <TableColumn fx:id="colPhone" text="Téléphone" prefWidth="100"/>
            </columns>
        </TableView>
    </center>

    <!-- Droite : Formulaire CRUD -->
    <right>
        <VBox spacing="15" prefWidth="320" style="-fx-border-color: #bdc3c7; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-background-color: #f9f9f9;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <BorderPane.margin>
                <Insets left="15"/>
            </BorderPane.margin>

            <Label text="Formulaire Réclamation" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <VBox spacing="5">
                <Label text="Sujet *"/>
                <TextField fx:id="sujetField" promptText="Sujet de la réclamation"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Message * (min 10 chars)"/>
                <TextArea fx:id="messageArea" promptText="Détails de la réclamation" prefRowCount="4"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Téléphone *"/>
                <TextField fx:id="telField" promptText="Ex: 0612345678"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Type de Service *"/>
                <ComboBox fx:id="typeComboBox" promptText="Choisir un type" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Statut"/>
                <ComboBox fx:id="statutComboBox" promptText="Choisir un statut" maxWidth="Infinity"/>
            </VBox>

            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <Button fx:id="btnAjouter" text="Ajouter" onAction="#handleAjouter" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="btnModifier" text="Modifier" onAction="#handleModifier" disable="true" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="btnSupprimer" text="Supprimer" onAction="#handleSupprimer" disable="true" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>

            <Button text="Vider le formulaire" onAction="#clearForm" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-border-color: #bdc3c7; -fx-text-fill: #7f8c8d;"/>
        </VBox>
    </right>

</BorderPane>
